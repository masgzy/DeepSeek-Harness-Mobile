# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/

# Android Studio / IntelliJ
.idea/
*.iml
captures/
local.properties

# CI 签名密钥 —— 默认不入库；例外见下方 release.keystore 白名单说明
*.jks
*.keystore
# release.keystore 例外：alpha 阶段使用仓库内置「社区构建签名密钥」（密码
# 同样公开，见 release.yml），保证各预发布版本之间可覆盖安装升级。
# 发布稳定版前应配置 RELEASE_KEYSTORE_B64 Secret，本文件即自动弃用。
!release.keystore

# 构建期生成的运行时资产（由 CI 的 scripts/fetch-proot.sh 下载注入）
app/src/main/assets/proot/
app/src/main/assets/runtime/
app/src/main/jniLibs/

# 运行时镜像构建产物
runtime/out/
*.tar.gz
*.tar.xz

# 日志与临时文件
*.log
.DS_Store
