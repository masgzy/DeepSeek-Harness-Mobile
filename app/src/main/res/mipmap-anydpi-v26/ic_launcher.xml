<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标：背景层纯白，前景层为蓝发女仆少女立绘（用户指定源图）。

     比例取值（gen 脚本 scripts/gen_icons.py，本地 PIL 生成）：
     前景内容按画布 62% 等比缩放居中（实测 bbox 61.3%x62.0%，中心零偏移）。
     依据：自适应画布 108dp，系统仅保证中心 66dp 圆（画布 61.1%）可见，
     62% 是"人物主体完整、外围点缀最多"的贴线取值——主体约占可见圆直径 86%。
     边角的爱心/鲸鱼/星星点缀在圆形遮罩下最远点 43.5% 边长处，外缘会被裁掉一角，
     属预期取舍（主体无裁切）；方形/圆角遮罩下基本完整。

     各层文件（mipmap-{mdpi,hdpi,xhdpi,xxhdpi,xxxhdpi}）：
     · ic_launcher_foreground.png  立绘内容居中（透明画布）
     · ic_launcher_background.png  纯白（与立绘白底无缝衔接）
     · ic_launcher.png             传统启动器：整图满幅方形
     · ic_launcher_round.png       传统圆形：圆形 alpha 蒙版（与方形字节不同，规避 IconDuplicates） -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>